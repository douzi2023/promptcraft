{
	"schemaVersion": 1,
	"id": "promptcraft",
	"version": "${version}",
	"name": "PromptCraft",
	"description": "In-game LLM agent for dynamic commands, procedural dynamic items/guns, minigames, and mod interoperability.",
	"authors": [
		"PromptCraft Team"
	],
	"contact": {
		"homepage": "https://github.com/promptcraft/promptcraft"
	},
	"license": "MIT",
	"icon": "assets/promptcraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.promptcraft.PromptCraft"
		],
		"client": [
			"com.promptcraft.client.PromptCraftClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
